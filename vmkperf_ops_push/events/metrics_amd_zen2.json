{
  "_comment": "Derived metrics for AMD Zen 2 hosts (events/rome.json). Same as metrics_amd.json except the L1D fill metrics: the Zen 2 event list has PMCx043 (demand fills by data source) and not PMCx044 (any fill), so these are L1D_Demand_Fill_* and count demand fills only. Names match the 'Guest Perf AMD' group of ops_metric_push v4.3.",
  "log_keys": [
    "IPC",
    "L2_DTLB_Miss_PTI",
    "L1D_Demand_Fill_Mem_PTI",
    "L2_Miss_PTI"
  ],
  "metrics": [
    {
      "key": "Cycles",
      "type": "sum",
      "src": "cycles",
      "desc": "core cycles not in halt in the interval"
    },
    {
      "key": "Instructions",
      "type": "sum",
      "src": "instr",
      "desc": "retired instructions in the interval"
    },
    {
      "key": "L2_DTLB_Miss",
      "type": "sum",
      "src": "l2_dtlb_miss",
      "desc": "L2 DTLB misses (page walks)"
    },
    {
      "key": "L1D_Demand_Fill_Mem",
      "type": "sum",
      "src": "dmnd_fill_mem",
      "desc": "L1 data cache demand fills from DRAM or IO"
    },
    {
      "key": "L2_Miss",
      "type": "sum",
      "src": "l2_miss",
      "desc": "core-to-L2 requests that missed L2 (no prefetch)"
    },
    {
      "key": "L1D_Demand_Fill_All",
      "type": "sum",
      "src": "dmnd_fill_all",
      "desc": "L1 data cache demand fills from every listed source"
    },
    {
      "key": "L1_DTLB_Miss",
      "type": "sum",
      "src": "l1_dtlb_miss",
      "desc": "L1 DTLB misses"
    },
    {
      "key": "L2_ITLB_Miss",
      "type": "sum",
      "src": "l2_itlb_miss",
      "desc": "L2 ITLB misses (page walks)"
    },
    {
      "key": "IPC",
      "type": "ratio",
      "num": "instr",
      "den": "cycles",
      "scale": 1,
      "desc": "instructions per cycle"
    },
    {
      "key": "L2_DTLB_Miss_PTI",
      "type": "ratio",
      "num": "l2_dtlb_miss",
      "den": "instr",
      "scale": 1000,
      "desc": "L2 DTLB misses per 1000 instructions"
    },
    {
      "key": "L1D_Demand_Fill_Mem_PTI",
      "type": "ratio",
      "num": "dmnd_fill_mem",
      "den": "instr",
      "scale": 1000,
      "desc": "L1D demand fills from DRAM or IO per 1000 instructions"
    },
    {
      "key": "L2_Miss_PTI",
      "type": "ratio",
      "num": "l2_miss",
      "den": "instr",
      "scale": 1000,
      "desc": "L2 misses per 1000 instructions"
    },
    {
      "key": "L1D_Demand_Fill_Mem_Pct",
      "type": "pct",
      "num": "dmnd_fill_mem",
      "den": "dmnd_fill_all",
      "desc": "share of L1D demand fills that came from DRAM or IO"
    },
    {
      "key": "L1_DTLB_Miss_PTI",
      "type": "ratio",
      "num": "l1_dtlb_miss",
      "den": "instr",
      "scale": 1000,
      "desc": "L1 DTLB misses per 1000 instructions"
    },
    {
      "key": "L2_ITLB_Miss_PTI",
      "type": "ratio",
      "num": "l2_itlb_miss",
      "den": "instr",
      "scale": 1000,
      "desc": "L2 ITLB misses per 1000 instructions"
    }
  ]
}