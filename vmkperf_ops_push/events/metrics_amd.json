{
  "_comment": "Derived metrics for AMD Zen hosts (events/naples.json, milan.json, genoa.json, turin.json; Zen 2 uses metrics_amd_zen2.json). Same rules as metrics.json: 'sum' = interval delta summed over the pCPU set; 'pct' = 100*num/den; 'ratio' = scale*num/den. A metric is skipped when any input event is not running or is not in the event file of the CPU generation: dc_fill_mem and dc_fill_all (PMCx044) exist from Zen 3 on, so the L1D_Fill_* metrics stay empty on Zen 1 hosts. _PTI = per thousand instructions, the unit AMD uses for its recommended metrics. Names match the 'Guest Perf AMD' group of ops_metric_push v4.3.",
  "log_keys": [
    "IPC",
    "L2_DTLB_Miss_PTI",
    "L1D_Fill_Mem_PTI",
    "L2_Miss_PTI"
  ],
  "metrics": [
    {
      "key": "Cycles",
      "type": "sum",
      "src": "cycles",
      "desc": "core cycles not in halt in the interval"
    },
    {
      "key": "Instructions",
      "type": "sum",
      "src": "instr",
      "desc": "retired instructions in the interval"
    },
    {
      "key": "L2_DTLB_Miss",
      "type": "sum",
      "src": "l2_dtlb_miss",
      "desc": "L2 DTLB misses (page walks)"
    },
    {
      "key": "L1D_Fill_Mem",
      "type": "sum",
      "src": "dc_fill_mem",
      "desc": "L1 data cache fills from DRAM or MMIO"
    },
    {
      "key": "L2_Miss",
      "type": "sum",
      "src": "l2_miss",
      "desc": "core-to-L2 requests that missed L2 (no prefetch)"
    },
    {
      "key": "L1D_Fill_All",
      "type": "sum",
      "src": "dc_fill_all",
      "desc": "L1 data cache fills from every source"
    },
    {
      "key": "L1_DTLB_Miss",
      "type": "sum",
      "src": "l1_dtlb_miss",
      "desc": "L1 DTLB misses"
    },
    {
      "key": "L2_ITLB_Miss",
      "type": "sum",
      "src": "l2_itlb_miss",
      "desc": "L2 ITLB misses (page walks)"
    },
    {
      "key": "IPC",
      "type": "ratio",
      "num": "instr",
      "den": "cycles",
      "scale": 1,
      "desc": "instructions per cycle"
    },
    {
      "key": "L2_DTLB_Miss_PTI",
      "type": "ratio",
      "num": "l2_dtlb_miss",
      "den": "instr",
      "scale": 1000,
      "desc": "L2 DTLB misses per 1000 instructions"
    },
    {
      "key": "L1D_Fill_Mem_PTI",
      "type": "ratio",
      "num": "dc_fill_mem",
      "den": "instr",
      "scale": 1000,
      "desc": "L1D fills from DRAM or MMIO per 1000 instructions"
    },
    {
      "key": "L2_Miss_PTI",
      "type": "ratio",
      "num": "l2_miss",
      "den": "instr",
      "scale": 1000,
      "desc": "L2 misses per 1000 instructions"
    },
    {
      "key": "L1D_Fill_Mem_Pct",
      "type": "pct",
      "num": "dc_fill_mem",
      "den": "dc_fill_all",
      "desc": "share of L1D fills that came from DRAM or MMIO"
    },
    {
      "key": "L1_DTLB_Miss_PTI",
      "type": "ratio",
      "num": "l1_dtlb_miss",
      "den": "instr",
      "scale": 1000,
      "desc": "L1 DTLB misses per 1000 instructions"
    },
    {
      "key": "L2_ITLB_Miss_PTI",
      "type": "ratio",
      "num": "l2_itlb_miss",
      "den": "instr",
      "scale": 1000,
      "desc": "L2 ITLB misses per 1000 instructions"
    }
  ]
}